{
    "models": {
        "denoiser": {
            "name": "SparseStructureFlowModel",
            "args": {
                "resolution": 16,
                "in_channels": 16,
                "out_channels": 16,
                "model_channels": 1536,
                "cond_channels": 1024,
                "num_blocks": 30,
                "num_heads": 12,
                "mlp_ratio": 5.3334,
                "pe_mode": "rope",
                "share_mod": true,
                "initialization": "scaled",
                "qk_rms_norm": true,
                "qk_rms_norm_cross": true,
                "use_checkpoint": true,
                "dtype": "bfloat16"
            }
        }
    },
    "dataset": {
        "name": "ImageConditionedTwoBranchSparseStructureLatent",
        "args": {
            "image_size": 512,
            "min_aesthetic_score": 0.0
        }
    },
    "trainer": {
        "name": "ImageConditionedFlowMatchingCFGTrainer",
        "args": {
            "max_steps": 200000,
            "batch_size_per_gpu": 32,
            "batch_split": 2,
            "val_split": 0.05,
            "patience": 5,
            "i_val": 300,
            "optimizer": {
                "name": "AdamW",
                "args": {
                    "lr": 0.0005,
                    "weight_decay": 0.01,
                    "betas": [
                        0.9,
                        0.95
                    ],
                    "eps": 1e-08
                }
            },
            "lr_scheduler": {
                "name": "ExponentialHold",
                "args": {
                    "T_max": 60000,
                    "eta_min": 1e-05,
                    "warmup_steps": 2000
                }
            },
            "ema_rate": [
                0.9999
            ],
            "mix_precision_mode": "amp",
            "mix_precision_dtype": "bfloat16",
            "p_uncond": 0.1,
            "t_schedule": {
                "name": "logitNormal",
                "args": {
                    "mean": 1.0,
                    "std": 1.0
                }
            },
            "sigma_min": 1e-05,
            "finetune_ckpt": {
                "denoiser": "two_branch_data/ss_body_aligned/pretrained_ss_flow.pt"
            },
            "snapshot_batch_size": 4,
            "i_log": 10,
            "i_sample": 1000000,
            "i_save": 500,
            "image_cond_model": {
                "name": "DinoV3FeatureExtractor",
                "args": {
                    "model_name": "facebook/dinov3-vitl16-pretrain-lvd1689m",
                    "image_size": 512
                }
            },
            "grad_clip": 1.0
        }
    }
}
